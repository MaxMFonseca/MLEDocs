---
import type { Locale } from '../../data/taxonomy';
import { resolveVersionEntryFromRouteId } from '../../lib/versions/manifest';
import AudiencePaths from './AudiencePaths.astro';
import HomeHero from './HomeHero.astro';
import SectionDirectory from './SectionDirectory.astro';
import SystemMap from './SystemMap.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const version = resolveVersionEntryFromRouteId(Astro.locals.starlightRoute.id);
---

<div data-mle-homepage data-mle-homepage-version={version.id}>
	<HomeHero {version} {locale} />
	<AudiencePaths {version} {locale} />
	<SectionDirectory {version} {locale} />
	<SystemMap {version} {locale} />
</div>
