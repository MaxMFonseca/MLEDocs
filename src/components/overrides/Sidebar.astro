---
import DefaultSidebar from '@astrojs/starlight/components/Sidebar.astro';
import {
	buildSidebarPagination,
	filterVersionedSidebarByLocale,
	flattenSingletonSidebarGroups,
	orderVersionedSidebarByRegistry,
} from '../../data/navigation';
import type { Locale } from '../../data/taxonomy';
import { versions } from '../../data/versions';

const route = Astro.locals.starlightRoute;
const locale: Locale = route.locale === 'pt-br' ? 'pt-br' : 'en';

// Pinned Starlight 0.41.5 exposes Sidebar as a supported component override and gives each page a
// cloned, locale-resolved route model. Its default Sidebar and later Footer read this same local,
// so align the released registry sections and their pagination before delegating rendering.
const visibleSidebar = filterVersionedSidebarByLocale(route.sidebar, versions, locale);
const orderedSidebar = orderVersionedSidebarByRegistry(visibleSidebar, versions, locale);
route.sidebar = [...flattenSingletonSidebarGroups(orderedSidebar)];
route.pagination = buildSidebarPagination(route.sidebar);
---

<DefaultSidebar />
