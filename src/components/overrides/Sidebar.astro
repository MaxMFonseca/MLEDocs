---
import DefaultSidebar from '@astrojs/starlight/components/Sidebar.astro';
import { filterVersionedSidebarByLocale } from '../../data/navigation';
import type { Locale } from '../../data/taxonomy';
import { versions } from '../../data/versions';

const route = Astro.locals.starlightRoute;
const locale: Locale = route.locale === 'pt-br' ? 'pt-br' : 'en';

// Pinned Starlight 0.41.5 exposes Sidebar as a supported component override and gives each page a
// cloned, locale-resolved route model. Its default Sidebar reads this same local, so replace only
// the resolved version groups before delegating all rendering and mobile behavior upstream.
route.sidebar = [...filterVersionedSidebarByLocale(route.sidebar, versions, locale)];
---

<DefaultSidebar />
