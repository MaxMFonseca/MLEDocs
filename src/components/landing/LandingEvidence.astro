---
import type { LandingCopy } from '../../lib/landing/copy';
import type { LandingModel } from '../../lib/landing/model';

interface Props {
	copy: LandingCopy;
	model: LandingModel;
}

const { copy, model } = Astro.props;
---

<aside class="landing-evidence" data-mle-landing-evidence aria-labelledby="landing-evidence-title">
	<div class="landing-evidence__intro">
		<p>{copy.evidence.eyebrow}</p>
		<h2 id="landing-evidence-title">{copy.evidence.title}</h2>
		<span>{copy.evidence.summary}</span>
	</div>

	<dl>
		<div>
			<dt>{copy.evidence.snapshot}</dt>
			<dd><code>{model.version.id}</code></dd>
		</div>
		<div>
			<dt>{copy.evidence.commitDate}</dt>
			<dd>{model.version.committedAt}</dd>
		</div>
		<div>
			<dt>{copy.evidence.status}</dt>
			<dd>{model.version.label[model.locale]}</dd>
		</div>
	</dl>

	<a class="landing-evidence__source" href={model.sourceDestination}>
		<span class="landing-evidence__source-label">
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path fill="currentColor" d="M12 .7A11.5 11.5 0 0 0 8.36 23.1c.58.1.79-.25.79-.56v-2.23c-3.24.7-3.92-1.37-3.92-1.37-.53-1.35-1.29-1.71-1.29-1.71-1.06-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.73 1.27 3.4.97.1-.75.4-1.27.74-1.56-2.58-.3-5.3-1.29-5.3-5.69 0-1.26.45-2.28 1.2-3.09-.12-.29-.52-1.48.11-3.05 0 0 .98-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.18-1.49 3.16-1.18 3.16-1.18.63 1.57.23 2.76.11 3.05.75.81 1.2 1.83 1.2 3.09 0 4.41-2.72 5.39-5.31 5.68.42.36.79 1.07.79 2.17v3.25c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" />
			</svg>
			{copy.evidence.source}
		</span>
		<code>{model.version.commit}</code>
	</a>
</aside>

<style>
	.landing-evidence {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(18rem, 1fr) minmax(14rem, 0.72fr);
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: center;
		margin-block: 0 clamp(4rem, 8vw, 7rem);
		padding: clamp(1.5rem, 4vw, 2.5rem);
		border: 1px solid var(--mle-border);
		border-top: 3px solid var(--mle-accent-bright);
		border-radius: var(--mle-radius-lg);
		background: var(--mle-surface-1);
		box-shadow: var(--mle-shadow-md);
	}
	.landing-evidence__intro p {
		margin: 0 0 var(--mle-space-3);
		color: var(--mle-accent-bright);
		font-family: var(--mle-font-code);
		font-size: 0.76rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.landing-evidence__intro h2 {
		margin: 0 0 var(--mle-space-3);
		color: var(--mle-text);
		font-size: clamp(1.4rem, 2.5vw, 2rem);
		line-height: 1.1;
	}
	.landing-evidence__intro > span {
		display: block;
		font-size: 0.95rem;
		line-height: 1.5;
	}
	dl {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin: 0;
	}
	dl div {
		min-width: 0;
		padding: var(--mle-space-3);
		border-bottom: 1px solid var(--mle-border);
	}
	dt { font-size: 0.8rem; }
	dd {
		margin: var(--mle-space-1) 0 0;
		color: var(--mle-text);
		font-weight: 650;
		line-height: 1.4;
	}
	dd code { font-size: 0.78rem; }
	.landing-evidence__source {
		display: grid;
		gap: var(--mle-space-2);
		min-width: 0;
		padding: var(--mle-space-4);
		border: 1px solid var(--mle-border);
		border-radius: var(--mle-radius-md);
		color: var(--mle-accent-bright);
		font-weight: 700;
		text-decoration: none;
	}
	.landing-evidence__source code {
		max-width: 100%;
		overflow-wrap: anywhere;
		color: var(--mle-text-muted);
		font-size: 0.7rem;
		font-weight: 400;
	}
	.landing-evidence__source-label {
		display: flex;
		gap: var(--mle-space-2);
		align-items: center;
	}
	.landing-evidence__source-label svg {
		width: 1.1rem;
		height: 1.1rem;
		flex: none;
	}
	@media (max-width: 62rem) {
		.landing-evidence { grid-template-columns: 1fr 1fr; }
		.landing-evidence__intro { grid-column: 1 / -1; }
	}
	@media (max-width: 52rem) {
		.landing-evidence { grid-template-columns: 1fr; }
		.landing-evidence__intro { grid-column: auto; }
		dl { grid-template-columns: 1fr; }
	}
</style>
