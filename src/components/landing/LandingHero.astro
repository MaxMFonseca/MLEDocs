---
import type { LandingModel } from '../../lib/landing/model';

interface Props {
	model: LandingModel;
}

const { model } = Astro.props;
const startHere = model.sections.find(({ section }) => section.pageId === 'start');
const systems = model.sections.find(({ section }) => section.pageId === 'systems');
if (!startHere || !systems) throw new Error('Landing hero requires start and systems destinations.');

const mediaSource = `${import.meta.env.BASE_URL}media/${model.version.id}/gameplay.webp`;
const sourceImage = `${model.version.repositoryUrl}/blob/${model.version.commit}/docs/media/gameplay.png`;
---

<section class="landing-hero" aria-labelledby="landing-title">
	<div class="landing-hero__copy">
		<p class="landing-eyebrow">Engine overview · pinned source documentation</p>
		<h1 id="landing-title">A C++23 game engine for building real-time experiences</h1>
		<p class="landing-hero__lede">
			MLE brings Vulkan rendering, model and animation systems, a Lua-driven retained UI,
			OpenAL audio, and SDL window and input into one documented codebase.
		</p>
		<p class="landing-hero__note">
			The repository also includes development tools, test applications, and an experimental
			server subsystem.
		</p>
		<div class="landing-hero__actions">
			<a class="landing-primary-action" href={startHere.href}>Start here</a>
			<a class="landing-secondary-action" href={systems.href}>Explore systems</a>
		</div>
	</div>

	<figure class="landing-hero__figure">
		<img
			src={mediaSource}
			alt="Gameplay scene rendered by MLE"
			width="1280"
			height="720"
			loading="eager"
			fetchpriority="high"
		/>
		<figcaption>
			<span>Gameplay output from the pinned MLE snapshot.</span>
			<a href={sourceImage}>View source image</a>
		</figcaption>
	</figure>
</section>

<style>
	.landing-hero {
		display: grid;
		grid-template-columns: minmax(0, 1.02fr) minmax(20rem, 0.98fr);
		gap: clamp(2.5rem, 6vw, 6rem);
		align-items: center;
		padding-block: clamp(4rem, 9vw, 7.5rem);
	}
	.landing-eyebrow {
		margin: 0 0 var(--mle-space-4);
		color: var(--mle-accent-bright);
		font-family: var(--mle-font-code);
		font-size: 0.76rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	h1 {
		max-width: 13ch;
		margin: 0;
		color: var(--mle-text);
		font-size: clamp(2.8rem, 6vw, 5.6rem);
		line-height: 0.98;
	}
	.landing-hero__lede {
		max-width: 40rem;
		margin: var(--mle-space-6) 0 0;
		color: var(--mle-text);
		font-size: clamp(1.15rem, 1.7vw, 1.35rem);
		line-height: 1.55;
	}
	.landing-hero__note {
		max-width: 40rem;
		margin: var(--mle-space-4) 0 0;
		line-height: 1.6;
	}
	.landing-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--mle-space-3);
		margin-top: var(--mle-space-6);
	}
	.landing-hero__actions a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 3rem;
		padding: 0.65rem 1.1rem;
		border: 1px solid var(--mle-accent-bright);
		border-radius: var(--mle-radius-md);
		font-weight: 700;
		text-decoration: none;
	}
	.landing-primary-action { background: var(--mle-accent-bright); color: var(--mle-bg); }
	.landing-secondary-action { background: var(--mle-surface-1); color: var(--mle-accent-bright); }
	.landing-hero__figure {
		margin: 0;
		padding: var(--mle-space-3);
		border: 1px solid var(--mle-border);
		border-radius: var(--mle-radius-lg);
		background: var(--mle-surface-1);
		box-shadow: var(--mle-shadow-md);
	}
	.landing-hero__figure img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--mle-radius-md);
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}
	figcaption {
		display: flex;
		flex-wrap: wrap;
		gap: var(--mle-space-2) var(--mle-space-4);
		justify-content: space-between;
		padding: var(--mle-space-3) var(--mle-space-1) var(--mle-space-1);
		font-family: var(--mle-font-code);
		font-size: 0.75rem;
		line-height: 1.5;
	}
	figcaption a { color: var(--mle-accent-bright); }
	@media (max-width: 52rem) {
		.landing-hero {
			grid-template-columns: 1fr;
			gap: var(--mle-space-7);
			padding-block: 3.5rem 4.5rem;
		}
		h1 { font-size: clamp(2.4rem, 12vw, 4.2rem); }
		.landing-hero__figure { min-width: 0; }
	}
</style>
