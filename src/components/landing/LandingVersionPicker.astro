---
import type { LandingCopy } from '../../lib/landing/copy';
import type { LandingModel } from '../../lib/landing/model';

interface Props {
	copy: LandingCopy;
	model: LandingModel;
}

const { copy, model } = Astro.props;
---

<label class="landing-version-picker">
	<span aria-hidden="true">{copy.header.versionPrefix}:</span>
	<select data-mle-landing-version-picker autocomplete="off" aria-label={copy.header.versionLabel}>
		{
			model.options.map((option) => (
				<option value={option.destination} selected={option.versionId === model.version.id}>
					{option.versionId}
				</option>
			))
		}
	</select>
</label>

<script is:inline>
	document.querySelector('[data-mle-landing-version-picker]')?.addEventListener('change', (event) => {
		if (event.currentTarget instanceof HTMLSelectElement) location.assign(event.currentTarget.value);
	});
</script>

<style>
	.landing-version-picker {
		display: flex;
		align-items: center;
		gap: var(--mle-space-1);
		border-radius: var(--mle-radius-md);
		color: var(--mle-text-muted);
		font-size: 0.875rem;
		white-space: nowrap;
	}

	.landing-version-picker:has(select:focus) {
		box-shadow:
			0 0 0 6px var(--mle-focus-outer),
			0 0 0 7px var(--mle-focus-edge);
	}

	select {
		width: 9.75rem;
		min-height: 2.5rem;
		padding: var(--mle-space-1) 1.7rem var(--mle-space-1) var(--mle-space-2);
		border: 0;
		background: transparent;
		color: var(--mle-accent-bright);
		font-family: var(--mle-font-code);
		font-size: 0.8rem;
		font-weight: 750;
		cursor: pointer;
	}
	select:hover { color: var(--mle-text); }

	select:focus {
		outline: 3px solid var(--mle-accent-bright);
		outline-offset: 2px;
		box-shadow: none;
	}

	@media (max-width: 52rem) {
		.landing-version-picker {
			width: max-content;
			max-width: 100%;
		}
	}
</style>
