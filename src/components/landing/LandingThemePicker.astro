---
import type { LandingCopy } from '../../lib/landing/copy';

interface Props { copy: LandingCopy; }
const { copy } = Astro.props;
const accessibleLabel = copy.header.themeLabel === 'Tema' ? 'Selecionar tema' : 'Select theme';
---

<starlight-theme-select>
	<label style="--sl-select-width: 6.25em">
		<span class="sr-only">{accessibleLabel}</span>
		<svg class="icon label-icon" data-mle-theme-icon width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M21 14h-1V7a3 3 0 0 0-3-3H7a3 3 0 0 0-3 3v7H3a1 1 0 0 0-1 1v2a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3v-2a1 1 0 0 0-1-1ZM6 7a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v7H6V7Zm14 10a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-1h16v1Z"></path>
		</svg>
		<select autocomplete="off" aria-label={accessibleLabel}>
			<option value="dark">{copy.header.themeDark}</option>
			<option value="light">{copy.header.themeLight}</option>
			<option value="auto" selected>{copy.header.themeAuto}</option>
		</select>
		<svg class="icon caret" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M17 9.17a1 1 0 0 0-1.41 0L12 12.71 8.46 9.17a1 1 0 1 0-1.41 1.42l4.24 4.24a1.002 1.002 0 0 0 1.42 0L17 10.59a1.002 1.002 0 0 0 0-1.42Z"></path>
		</svg>
	</label>
</starlight-theme-select>

<script is:inline>
	(() => {
		const picker = document.querySelector('starlight-theme-select select');
		if (!(picker instanceof HTMLSelectElement)) return;
		const icon = document.querySelector('[data-mle-theme-icon] path');
		const iconPaths = {
			auto: 'M21 14h-1V7a3 3 0 0 0-3-3H7a3 3 0 0 0-3 3v7H3a1 1 0 0 0-1 1v2a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3v-2a1 1 0 0 0-1-1ZM6 7a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v7H6V7Zm14 10a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-1h16v1Z',
			dark: 'M21.64 13a1 1 0 0 0-1.05-.14 8.049 8.049 0 0 1-3.37.73 8.15 8.15 0 0 1-8.14-8.1 8.59 8.59 0 0 1 .25-2A1 1 0 0 0 8 2.36a10.14 10.14 0 1 0 14 11.69 1 1 0 0 0-.36-1.05Zm-9.5 6.69A8.14 8.14 0 0 1 7.08 5.22v.27a10.15 10.15 0 0 0 10.14 10.14 9.784 9.784 0 0 0 2.1-.22 8.11 8.11 0 0 1-7.18 4.32v-.04Z',
			light: 'M5 12a1 1 0 0 0-1-1H3a1 1 0 0 0 0 2h1a1 1 0 0 0 1-1Zm.64 5-.71.71a1 1 0 0 0 0 1.41 1 1 0 0 0 1.41 0l.71-.71A1 1 0 0 0 5.64 17ZM12 5a1 1 0 0 0 1-1V3a1 1 0 0 0-2 0v1a1 1 0 0 0 1 1Zm5.66 2.34a1 1 0 0 0 .7-.29l.71-.71a1 1 0 1 0-1.41-1.41l-.66.71a1 1 0 0 0 0 1.41 1 1 0 0 0 .66.29Zm-12-.29a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.71-.71a1.004 1.004 0 1 0-1.43 1.41l.73.71ZM21 11h-1a1 1 0 0 0 0 2h1a1 1 0 0 0 0-2Zm-2.64 6A1 1 0 0 0 17 18.36l.71.71a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.76-.66ZM12 6.5a5.5 5.5 0 1 0 5.5 5.5A5.51 5.51 0 0 0 12 6.5Zm0 9a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Zm0 3.5a1 1 0 0 0-1 1v1a1 1 0 0 0 2 0v-1a1 1 0 0 0-1-1Z',
		};
		const preference = matchMedia('(prefers-color-scheme: light)');
		const loadTheme = () => {
			const stored = localStorage.getItem('starlight-theme');
			return stored === 'dark' || stored === 'light' ? stored : 'auto';
		};
		const applyTheme = (theme) => {
			if (icon instanceof SVGPathElement) icon.setAttribute('d', iconPaths[theme]);
			document.documentElement.dataset.theme = theme === 'auto'
				? preference.matches ? 'light' : 'dark'
				: theme;
			localStorage.setItem('starlight-theme', theme === 'auto' ? '' : theme);
		};
		picker.value = loadTheme();
		if (icon instanceof SVGPathElement) icon.setAttribute('d', iconPaths[picker.value]);
		picker.addEventListener('change', () => applyTheme(picker.value));
		preference.addEventListener('change', () => {
			if (picker.value === 'auto') applyTheme('auto');
		});
	})();
</script>

<style>
	starlight-theme-select { display: block; }
	label {
		--sl-label-icon-size: 0.875rem;
		--sl-caret-size: 1.25rem;
		--sl-inline-padding: 0.5rem;
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.25rem;
		color: var(--sl-color-gray-2);
	}
	label:hover { color: var(--sl-color-white); }
	.icon {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		pointer-events: none;
	}
	.label-icon {
		font-size: var(--sl-label-icon-size);
		inset-inline-start: 0;
		width: 1em;
		height: 1em;
	}
	.caret {
		font-size: var(--sl-caret-size);
		inset-inline-end: 0;
		width: 1em;
		height: 1em;
	}
	select {
		width: calc(var(--sl-select-width) + var(--sl-inline-padding) * 2);
		margin-inline: calc(var(--sl-inline-padding) * -1);
		padding-block: 0.625rem;
		padding-inline: calc(var(--sl-label-icon-size) + var(--sl-inline-padding) + 0.25rem)
			calc(var(--sl-caret-size) + var(--sl-inline-padding) + 0.25rem);
		border: 0;
		background: transparent;
		color: inherit;
		font-size: var(--sl-text-sm, 0.875rem);
		text-overflow: ellipsis;
		cursor: pointer;
		appearance: none;
	}
	option { background: var(--sl-color-bg-nav); color: var(--sl-color-gray-1); }
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
