---
import type { NavigationPageId } from '../../data/navigation';
import type { LandingModel } from '../../lib/landing/model';

interface Props {
	model: LandingModel;
}

interface FeatureBand {
	readonly number: string;
	readonly label: string;
	readonly title: string;
	readonly summary: string;
	readonly facts: readonly string[];
	readonly destinationId: NavigationPageId;
}

const { model } = Astro.props;
const featureBands: readonly FeatureBand[] = [
	{
		number: '01',
		label: 'Foundation and platform',
		title: 'A C++23 core connected to the host platform',
		summary:
			'MLE organizes runtime ownership, math, utilities, events, and concurrency around a C++23 foundation.',
		facts: [
			'SDL supplies window creation, focus, text, and input boundaries.',
			'The Client layer connects engine systems to an interactive application.',
			'A server subsystem exists in the snapshot and is documented as experimental.',
		],
		destinationId: 'concepts',
	},
	{
		number: '02',
		label: 'Rendering and content',
		title: 'Vulkan rendering with models and animation',
		summary:
			'The renderer covers frame flow, queues, resources, synchronization, shaders, pipelines, render targets, and text composition.',
		facts: [
			'Model workflows load meshes and materials into renderer-owned resources.',
			'Animation support connects skeletons, cameras, and per-frame control.',
			'Guides and references trace the same pinned implementation contracts.',
		],
		destinationId: 'systems',
	},
	{
		number: '03',
		label: 'Runtime integrations',
		title: 'Lua-driven UI, OpenAL audio, and working tools',
		summary:
			'MLE exposes a retained interface system to Lua, with layout, input, events, reusable components, scrolling, and visual effects.',
		facts: [
			'OpenAL-backed audio covers playback, streaming, buses, voices, and command flow.',
			'Tool and test applications exercise Core, models, UI, audio, and the Client layer.',
			'Test fixtures support repeatable development and documentation workflows.',
		],
		destinationId: 'tools',
	},
];
---

<section class="landing-features" aria-labelledby="landing-features-title">
	<div class="landing-features__heading">
		<p>Engine capabilities</p>
		<h2 id="landing-features-title">Follow the systems from foundation to feedback</h2>
	</div>

	<div class="landing-features__bands">
		{
			featureBands.map((feature) => {
				const destination = model.sections.find(
					({ section }) => section.pageId === feature.destinationId,
				);
				if (!destination) throw new Error(`Missing landing destination ${feature.destinationId}.`);

				return (
					<section class="landing-feature" data-mle-landing-feature aria-labelledby={`landing-feature-${feature.number}`}>
						<div class="landing-feature__intro">
							<p class="landing-feature__label">{feature.number} · {feature.label}</p>
							<h3 id={`landing-feature-${feature.number}`}>{feature.title}</h3>
							<p>{feature.summary}</p>
							<a href={destination.href}>Open {destination.section.labels.en}</a>
						</div>
						<ul>
							{feature.facts.map((fact) => <li>{fact}</li>)}
						</ul>
					</section>
				);
			})
		}
	</div>
</section>

<style>
	.landing-features {
		padding-block: clamp(3rem, 7vw, 6rem);
		border-top: 1px solid var(--mle-border);
	}
	.landing-features__heading {
		display: grid;
		grid-template-columns: minmax(9rem, 0.45fr) minmax(0, 1fr);
		gap: var(--mle-space-6);
		align-items: end;
		margin-bottom: var(--mle-space-7);
	}
	.landing-features__heading p,
	.landing-feature__label {
		margin: 0;
		color: var(--mle-accent-bright);
		font-family: var(--mle-font-code);
		font-size: 0.76rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.landing-features__heading h2 {
		max-width: 19ch;
		margin: 0;
		color: var(--mle-text);
		font-size: clamp(2rem, 4vw, 3.6rem);
		line-height: 1.05;
	}
	.landing-features__bands { border-top: 1px solid var(--mle-border); }
	.landing-feature {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.95fr);
		gap: clamp(2rem, 6vw, 6rem);
		align-items: center;
		padding-block: clamp(2.5rem, 6vw, 5rem);
		border-bottom: 1px solid var(--mle-border);
	}
	.landing-feature:nth-child(even) .landing-feature__intro { order: 2; }
	.landing-feature:nth-child(even) ul { order: 1; }
	.landing-feature h3 {
		max-width: 18ch;
		margin: var(--mle-space-4) 0;
		color: var(--mle-text);
		font-size: clamp(1.75rem, 3vw, 2.8rem);
		line-height: 1.08;
	}
	.landing-feature__intro > p:not(.landing-feature__label) {
		max-width: 52ch;
		line-height: 1.65;
	}
	.landing-feature a {
		display: inline-block;
		margin-top: var(--mle-space-3);
		color: var(--mle-accent-bright);
		font-weight: 700;
		text-underline-offset: 0.25em;
	}
	.landing-feature ul {
		margin: 0;
		padding: var(--mle-space-5) var(--mle-space-5) var(--mle-space-5) 2.8rem;
		border: 1px solid var(--mle-border);
		border-left: 3px solid var(--mle-accent-bright);
		border-radius: var(--mle-radius-md);
		background: var(--mle-surface-1);
		box-shadow: var(--mle-shadow-sm);
	}
	.landing-feature li { padding-block: var(--mle-space-2); line-height: 1.55; }
	@media (max-width: 52rem) {
		.landing-features__heading,
		.landing-feature { grid-template-columns: 1fr; }
		.landing-feature:nth-child(even) .landing-feature__intro,
		.landing-feature:nth-child(even) ul { order: initial; }
	}
</style>
