---
import type { LandingModel } from '../../lib/landing/model';
import LandingVersionPicker from './LandingVersionPicker.astro';

interface Props {
	model: LandingModel;
}

const { model } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<header class="landing-header">
	<div class="landing-header__inner">
		<a class="landing-brand" href={base} aria-label="MLE documentation home">MLE</a>
		<div class="landing-version"><LandingVersionPicker {model} /></div>
		<nav class="landing-actions" aria-label="Documentation and source links">
			<a href={model.englishHome} hreflang="en">Read in English</a>
			<a href={model.portugueseHome} hreflang="pt-BR" lang="pt-BR">Ler em português</a>
			<a href={model.version.repositoryUrl}>GitHub</a>
		</nav>
	</div>
</header>

<style>
	.landing-header {
		border-bottom: 1px solid var(--mle-border);
		background: color-mix(in srgb, var(--mle-bg) 92%, transparent);
		box-shadow: var(--mle-shadow-sm);
	}
	.landing-header__inner {
		display: grid;
		grid-template-columns: auto minmax(15rem, 22rem) auto;
		gap: var(--mle-space-6);
		align-items: center;
		width: min(76rem, calc(100% - 3rem));
		min-height: 5.5rem;
		margin-inline: auto;
	}
	.landing-brand {
		color: var(--mle-accent-bright);
		font-family: var(--mle-font-heading);
		font-size: 1.5rem;
		font-weight: 750;
		letter-spacing: -0.04em;
		text-decoration: none;
	}
	.landing-version { min-width: 0; }
	.landing-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--mle-space-5);
		justify-content: flex-end;
		font-size: 0.92rem;
	}
	.landing-actions a {
		color: var(--mle-text);
		font-weight: 650;
		text-decoration-color: var(--mle-border);
		text-underline-offset: 0.24em;
	}
	.landing-actions a:hover {
		color: var(--mle-accent-bright);
		text-decoration-color: currentColor;
	}
	@media (max-width: 52rem) {
		.landing-header__inner {
			grid-template-columns: 1fr;
			gap: var(--mle-space-4);
			width: min(100% - 2rem, 40rem);
			padding-block: var(--mle-space-5);
		}
		.landing-actions { justify-content: flex-start; }
	}
</style>
