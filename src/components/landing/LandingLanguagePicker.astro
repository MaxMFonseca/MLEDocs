---
import type { Locale } from '../../data/taxonomy';
import type { LandingCopy } from '../../lib/landing/copy';
import type { LandingModel } from '../../lib/landing/model';
import FlagLanguageSelect from '../controls/FlagLanguageSelect.astro';

interface Props {
	copy: LandingCopy;
	locale: Locale;
	model: LandingModel;
}

const { copy, locale, model } = Astro.props;
const englishLanding = locale === 'en' ? model.landingHome : model.alternateLanding;
const portugueseLanding = locale === 'pt-br' ? model.landingHome : model.alternateLanding;
const options = [
	{ label: 'English', locale: 'en', value: englishLanding },
	{ label: 'Português (Brasil)', locale: 'pt-br', value: portugueseLanding },
] as const;
---

<FlagLanguageSelect
	activeLocale={locale}
	label={copy.header.languageLabel}
	{options}
	placement="landing"
/>
