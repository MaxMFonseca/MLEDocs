---
import type { Locale } from '../../data/taxonomy';
import type { LandingCopy } from '../../lib/landing/copy';
import type { LandingModel } from '../../lib/landing/model';

interface Props {
	copy: LandingCopy;
	locale: Locale;
	model: LandingModel;
}

const { copy, locale, model } = Astro.props;
const englishLanding = locale === 'en' ? model.landingHome : model.alternateLanding;
const portugueseLanding = locale === 'pt-br' ? model.landingHome : model.alternateLanding;
---

<label class="landing-language-picker">
	<span>{copy.header.languageLabel}</span>
	<select data-mle-landing-language-picker autocomplete="off">
		<option value={englishLanding} selected={locale === 'en'}>English</option>
		<option value={portugueseLanding} selected={locale === 'pt-br'}>Português (Brasil)</option>
	</select>
</label>

<script is:inline>
	document.querySelector('[data-mle-landing-language-picker]')?.addEventListener('change', (event) => {
		if (event.currentTarget instanceof HTMLSelectElement) location.assign(event.currentTarget.value);
	});
</script>

<style>
	.landing-language-picker {
		display: grid;
		gap: var(--mle-space-2);
		border-radius: var(--mle-radius-md);
		color: var(--mle-text-muted);
		font-size: 0.8rem;
	}

	.landing-language-picker:has(select:focus) {
		box-shadow:
			0 0 0 6px var(--mle-focus-outer),
			0 0 0 7px var(--mle-focus-edge);
	}

	select {
		width: 100%;
		min-height: 2.5rem;
		padding: var(--mle-space-1) var(--mle-space-2);
		border: 1px solid var(--mle-border);
		border-radius: var(--mle-radius-md);
		background: var(--mle-surface-2);
		color: var(--mle-text);
		font-family: var(--mle-font-code);
		font-size: 0.78rem;
	}

	select:focus {
		outline: 3px solid var(--mle-accent-bright);
		outline-offset: 2px;
		box-shadow: none;
	}

	@media (max-width: 52rem) {
		.landing-language-picker { width: 100%; }
	}
</style>
