---
import type { Locale } from '../../data/taxonomy';
import type { LandingCopy } from '../../lib/landing/copy';
import type { LandingModel } from '../../lib/landing/model';

interface Props {
	copy: LandingCopy;
	locale: Locale;
	model: LandingModel;
}

const { copy, locale, model } = Astro.props;
const englishLanding = locale === 'en' ? model.landingHome : model.alternateLanding;
const portugueseLanding = locale === 'pt-br' ? model.landingHome : model.alternateLanding;
---

<nav class="landing-language-options" data-mle-landing-language-options aria-label={copy.header.languageLabel}>
	<a href={englishLanding} aria-label="English" aria-current={locale === 'en' ? 'page' : undefined}>
		<svg data-mle-language-flag="en" viewBox="0 0 28 20" aria-hidden="true">
			<rect width="28" height="20" fill="#b22234"></rect>
			<path d="M0 2h28v2H0zm0 4h28v2H0zm0 4h28v2H0zm0 4h28v2H0zm0 4h28v2H0z" fill="#fff"></path>
			<rect width="12" height="10" fill="#3c3b6e"></rect>
			<path d="M2 2h1v1H2zm3 0h1v1H5zm3 0h1v1H8zm2 0h1v1h-1zM3.5 4h1v1h-1zm3 0h1v1h-1zm3 0h1v1h-1zM2 6h1v1H2zm3 0h1v1H5zm3 0h1v1H8zm2 0h1v1h-1zM3.5 8h1v1h-1zm3 0h1v1h-1zm3 0h1v1h-1z" fill="#fff"></path>
		</svg>
	</a>
	<a href={portugueseLanding} aria-label="Português (Brasil)" aria-current={locale === 'pt-br' ? 'page' : undefined}>
		<svg data-mle-language-flag="pt-br" viewBox="0 0 28 20" aria-hidden="true">
			<rect width="28" height="20" fill="#009b3a"></rect>
			<path d="m14 2.5 11 7.5-11 7.5L3 10Z" fill="#ffdf00"></path>
			<circle cx="14" cy="10" r="4.4" fill="#002776"></circle>
			<path d="M10.2 9.1c2.8-.8 5.6-.3 7.8 1.2" fill="none" stroke="#fff" stroke-width="1"></path>
		</svg>
	</a>
</nav>

<style>
	.landing-language-options { display: flex; gap: var(--mle-space-2); }
	a {
		display: inline-grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 1px solid var(--mle-border);
		border-radius: var(--mle-radius-md);
		background: var(--mle-surface-2);
		text-decoration: none;
	}
	a svg { width: 1.45rem; height: auto; border-radius: 0.12rem; }
	a[aria-current='page'] {
		border-color: var(--mle-accent-bright);
		background: color-mix(in srgb, var(--mle-accent) 15%, var(--mle-surface-2));
		box-shadow: inset 0 0 0 1px var(--mle-accent-bright);
	}
	a:hover { border-color: var(--mle-accent-bright); }
	a:focus {
		outline: 3px solid var(--mle-accent-bright);
		outline-offset: 2px;
		box-shadow: 0 0 0 6px var(--mle-focus-outer);
	}
</style>
