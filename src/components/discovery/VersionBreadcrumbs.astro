---
import { navigationSections } from '../../data/navigation';
import type { Locale } from '../../data/taxonomy';
import { versions } from '../../data/versions';
import { buildBreadcrumbModel } from '../../lib/navigation/breadcrumbs';
import { parseDocumentationRoute } from '../../lib/navigation/route-context';

interface Props {
	readonly locale: Locale;
	readonly pageId?: string;
	readonly pageTitle: string;
	readonly routeId: string;
}

const { locale, pageId, pageTitle, routeId } = Astro.props;
const breadcrumbs = buildBreadcrumbModel({
	route: parseDocumentationRoute(routeId, locale),
	pageId,
	pageTitle,
	versions,
	sections: navigationSections,
	base: import.meta.env.BASE_URL,
});
const navigationLabel = locale === 'pt-br' ? 'Caminho de navegação' : 'Breadcrumb';
---

{
	breadcrumbs.length > 0 && (
		<nav
			class="version-breadcrumbs"
			data-mle-version-breadcrumbs
			aria-label={navigationLabel}
		>
			<ol>
				{
					breadcrumbs.map((item, index) => (
						<li>
							{
								item.href ? (
									<a href={item.href} title={item.title}>
										{item.title ? (
											<code data-mle-breadcrumb-label>{item.label}</code>
										) : (
											<span data-mle-breadcrumb-label>{item.label}</span>
										)}
									</a>
								) : (
									<span
										data-mle-breadcrumb-label
										aria-current={item.current ? 'page' : undefined}
										title={item.title}
									>
										{item.label}
									</span>
								)
							}
							{index < breadcrumbs.length - 1 && <span class="separator" aria-hidden="true">/</span>}
						</li>
					))
				}
			</ol>
		</nav>
	)
}

<style>
	.version-breadcrumbs {
		margin-block: 0 var(--mle-space-3);
		color: var(--mle-text-muted);
		font-size: 0.8125rem;
		line-height: 1.45;
	}

	ol {
		display: flex;
		flex-wrap: wrap;
		gap: var(--mle-space-1);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li {
		display: inline-flex;
		align-items: baseline;
		min-width: 0;
		gap: var(--mle-space-1);
	}

	a {
		color: var(--mle-accent-bright);
		text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
		text-underline-offset: 0.15em;
		overflow-wrap: anywhere;
	}

	code {
		font-size: inherit;
	}

	[aria-current='page'] {
		color: var(--mle-text);
		font-weight: 600;
		overflow-wrap: anywhere;
	}

	.separator {
		color: var(--mle-text-muted);
	}

	@media (max-width: 31.25rem) {
		.version-breadcrumbs {
			font-size: 0.75rem;
		}
	}
</style>
