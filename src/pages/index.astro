---
import { navigationSections } from '../data/navigation';
import { getCurrentVersion } from '../lib/versions/manifest';
import { docsPath } from '../lib/links/base';
import '../styles/tokens.css';
import '../styles/typography.css';
import '../styles/global.css';

const current = getCurrentVersion();
const orderedSections = [...navigationSections].sort((left, right) => left.order - right.order);
const englishHome = docsPath({ locale: 'en', versionId: current.id, slug: '' });
const portugueseHome = docsPath({ locale: 'pt-br', versionId: current.id, slug: '' });
const base = import.meta.env.BASE_URL;
const canonical = new URL(base, Astro.site).toString();
const favicon = `${base}favicon.svg`;
---

<!doctype html>
<html lang="en">
	<head>
		<script is:inline>
			(() => {
				const stored = localStorage.getItem('starlight-theme');
				const theme =
					stored === 'light' || stored === 'dark'
						? stored
						: matchMedia('(prefers-color-scheme: light)').matches
							? 'light'
							: 'dark';
				document.documentElement.dataset.theme = theme;
			})();
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Versioned documentation for MLE, grounded in a pinned source commit."
		/>
		<link rel="icon" type="image/svg+xml" href={favicon} />
		<link rel="canonical" href={canonical} />
		<title>MLE documentation</title>
	</head>
	<body data-pagefind-ignore>
		<header class="landing-header">
			<a class="brand" href={base} aria-label="MLE documentation home">MLE</a>
			<div class="header-context">
				<span>Versioned documentation</span>
				<a href={current.repositoryUrl}>Source repository</a>
			</div>
		</header>

		<main data-mle-landing data-mle-landing-version={current.id}>
			<section class="hero" aria-labelledby="landing-title">
				<div class="hero-copy">
					<p class="eyebrow">Documentation for one exact source snapshot</p>
					<h1 id="landing-title">MLE documentation</h1>
					<p class="lede">
						Understand the engine as it exists in source: its architecture, systems, workflows,
						and evidence—without drifting across commits.
					</p>
					<div class="language-actions" aria-label="Choose documentation language">
						<a class="primary-action" href={englishHome}>Read in English</a>
						<a class="secondary-action" href={portugueseHome} lang="pt-BR">Ler em português</a>
					</div>
				</div>

				<aside class="snapshot-card" aria-label="Current documentation snapshot">
					<p class="snapshot-label">Current snapshot</p>
					<code>{current.id}</code>
					<dl>
						<div>
							<dt>Commit date</dt>
							<dd>{current.committedAt}</dd>
						</div>
						<div>
							<dt>Status</dt>
							<dd>{current.label.en}</dd>
						</div>
						<div>
							<dt>Languages</dt>
							<dd>English · Português</dd>
						</div>
					</dl>
					<a href={`${current.repositoryUrl}/tree/${current.commit}`}>Inspect this commit on GitHub</a>
				</aside>
			</section>

			<section class="directory" aria-labelledby="directory-title">
				<div class="section-heading">
					<p class="eyebrow">Documentation directory</p>
					<h2 id="directory-title">Choose where to start</h2>
					<p>Each section stays pinned to <code>{current.id}</code>.</p>
				</div>

				<div class="section-grid">
					{
						orderedSections.map((section) => (
							<a
								class="section-card"
								data-accent={section.accent}
								data-mle-landing-section={section.pageId}
								href={docsPath({
									locale: 'en',
									versionId: current.id,
									slug: section.segment,
								})}
							>
								<span class="section-number">0{section.order}</span>
								<span class="section-copy">
									<strong>{section.labels.en}</strong>
									<small lang="pt-BR">{section.labels['pt-br']}</small>
									<span>{section.summaries.en}</span>
								</span>
								<span class="arrow" aria-hidden="true">↗</span>
							</a>
						))
					}
				</div>
			</section>
		</main>

		<footer>
			<span>MLE documentation</span>
			<span>Snapshot {current.id}</span>
		</footer>
	</body>
</html>

<style>
	:global(html) {
		min-width: 20rem;
	}

	:global(body) {
		margin: 0;
		min-height: 100vh;
		background:
			radial-gradient(circle at 78% 8%, color-mix(in srgb, var(--mle-accent) 13%, transparent), transparent 29rem),
			var(--mle-bg);
	}

	.landing-header,
	main,
	footer {
		width: min(76rem, calc(100% - 3rem));
		margin-inline: auto;
	}

	.landing-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 4.5rem;
		border-bottom: 1px solid var(--mle-border);
	}

	.brand {
		font-family: var(--mle-font-heading);
		font-size: 1.45rem;
		font-weight: 750;
		letter-spacing: -0.04em;
		color: var(--mle-accent-bright);
		text-decoration: none;
	}

	.header-context {
		display: flex;
		gap: var(--mle-space-5);
		align-items: center;
		font-size: 0.9rem;
		color: var(--mle-text-muted);
	}

	a {
		color: var(--mle-accent-bright);
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.45fr) minmax(17rem, 0.72fr);
		gap: clamp(2rem, 6vw, 6rem);
		align-items: end;
		padding-block: clamp(4.5rem, 10vw, 8rem) clamp(4rem, 8vw, 7rem);
	}

	.eyebrow,
	.snapshot-label,
	.section-number {
		margin: 0 0 var(--mle-space-3);
		font-family: var(--mle-font-code);
		font-size: 0.76rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--mle-accent-bright);
	}

	h1 {
		max-width: 10ch;
		margin: 0;
		font-size: clamp(3.4rem, 7vw, 6.25rem);
		line-height: 0.92;
		color: var(--mle-text);
	}

	.lede {
		max-width: 42rem;
		margin: var(--mle-space-6) 0 0;
		font-size: clamp(1.15rem, 2vw, 1.4rem);
		line-height: 1.55;
		color: var(--mle-text-muted);
	}

	.language-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--mle-space-3);
		margin-top: var(--mle-space-6);
	}

	.language-actions a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 3rem;
		padding: 0.65rem 1.1rem;
		border: 1px solid var(--mle-accent-bright);
		border-radius: var(--mle-radius-md);
		font-weight: 650;
		text-decoration: none;
	}

	.primary-action {
		background: var(--mle-accent-bright);
		color: var(--mle-bg);
	}

	.secondary-action {
		background: color-mix(in srgb, var(--mle-surface-1) 86%, transparent);
	}

	.snapshot-card {
		position: relative;
		padding: var(--mle-space-6);
		border: 1px solid var(--mle-border);
		border-top: 3px solid var(--mle-accent-bright);
		border-radius: var(--mle-radius-lg);
		background: color-mix(in srgb, var(--mle-surface-1) 90%, transparent);
		box-shadow: var(--mle-shadow-md);
	}

	.snapshot-card > code {
		display: block;
		margin-bottom: var(--mle-space-5);
		font-size: 1.05rem;
		color: var(--mle-text);
	}

	dl {
		margin: 0 0 var(--mle-space-5);
	}

	dl div {
		display: flex;
		justify-content: space-between;
		gap: var(--mle-space-3);
		padding-block: var(--mle-space-2);
		border-bottom: 1px solid var(--mle-border);
	}

	dt {
		color: var(--mle-text-muted);
	}

	dd {
		margin: 0;
		color: var(--mle-text);
	}

	.directory {
		padding-block: 0 clamp(5rem, 10vw, 9rem);
	}

	.section-heading {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: end;
		gap: var(--mle-space-4);
		margin-bottom: var(--mle-space-6);
	}

	.section-heading .eyebrow {
		grid-column: 1 / -1;
		margin-bottom: 0;
	}

	h2 {
		margin: 0;
		font-size: clamp(2rem, 4vw, 3.2rem);
		color: var(--mle-text);
	}

	.section-heading > p:last-child {
		margin: 0;
	}

	.section-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		border-top: 1px solid var(--mle-border);
	}

	.section-card {
		--section-accent: var(--mle-accent-bright);
		display: grid;
		grid-template-columns: 2rem minmax(0, 1fr) auto;
		gap: var(--mle-space-4);
		min-width: 0;
		padding: var(--mle-space-5);
		border-bottom: 1px solid var(--mle-border);
		color: var(--mle-text-muted);
		text-decoration: none;
		transition:
			background var(--mle-motion-base) var(--mle-motion-ease),
			transform var(--mle-motion-base) var(--mle-motion-ease);
	}

	.section-card:nth-child(odd) {
		border-inline-end: 1px solid var(--mle-border);
	}

	.section-card:last-child:nth-child(odd) {
		grid-column: 1 / -1;
		border-inline-end: 0;
	}

	.section-card[data-accent='core'] { --section-accent: var(--mle-core); }
	.section-card[data-accent='renderer'] { --section-accent: var(--mle-renderer); }
	.section-card[data-accent='lua-ui'] { --section-accent: var(--mle-lua-ui); }
	.section-card[data-accent='audio'] { --section-accent: var(--mle-audio); }
	.section-card[data-accent='tools'] { --section-accent: var(--mle-tools); }

	.section-card:hover {
		background: var(--mle-surface-1);
		transform: translateY(-2px);
	}

	.section-number,
	.arrow {
		color: var(--section-accent);
	}

	.section-copy {
		display: grid;
		gap: var(--mle-space-2);
		min-width: 0;
	}

	.section-copy strong {
		font-family: var(--mle-font-heading);
		font-size: 1.3rem;
		color: var(--mle-text);
	}

	.section-copy small {
		font-family: var(--mle-font-code);
		color: var(--section-accent);
	}

	.section-copy > span {
		line-height: 1.5;
	}

	.arrow {
		font-size: 1.15rem;
	}

	footer {
		display: flex;
		justify-content: space-between;
		gap: var(--mle-space-4);
		padding-block: var(--mle-space-5);
		border-top: 1px solid var(--mle-border);
		font-family: var(--mle-font-code);
		font-size: 0.8rem;
		color: var(--mle-text-muted);
	}

	@media (max-width: 52rem) {
		.landing-header,
		main,
		footer {
			width: min(100% - 2rem, 40rem);
		}

		.header-context span {
			display: none;
		}

		.hero {
			grid-template-columns: 1fr;
			gap: var(--mle-space-7);
			padding-block: 4rem 5rem;
		}

		h1 {
			font-size: clamp(2.2rem, 11vw, 4rem);
		}

		.snapshot-card {
			padding: var(--mle-space-5);
		}

		.section-heading {
			grid-template-columns: 1fr;
		}

		.section-grid {
			grid-template-columns: 1fr;
		}

		.section-card:nth-child(odd) {
			border-inline-end: 0;
		}

		.section-card:last-child:nth-child(odd) {
			grid-column: auto;
		}

		footer {
			flex-direction: column;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.section-card {
			transition: none;
		}
	}
</style>
