---
import LandingDirectory from '../components/landing/LandingDirectory.astro';
import LandingEvidence from '../components/landing/LandingEvidence.astro';
import LandingFeatures from '../components/landing/LandingFeatures.astro';
import LandingHeader from '../components/landing/LandingHeader.astro';
import LandingHero from '../components/landing/LandingHero.astro';
import { versions } from '../data/versions';
import { buildLandingModel } from '../lib/landing/model';
import { getCurrentVersion } from '../lib/versions/manifest';
import '../styles/tokens.css';
import '../styles/typography.css';
import '../styles/global.css';

const current = getCurrentVersion(versions);
const landing = buildLandingModel(versions, current.id);
const base = import.meta.env.BASE_URL;
const canonical = new URL(base, Astro.site).toString();
const favicon = `${base}favicon.png`;
---

<!doctype html>
<html lang="en">
	<head>
		<script is:inline>
			(() => {
				const stored = localStorage.getItem('starlight-theme');
				const theme =
					stored === 'light' || stored === 'dark'
						? stored
						: matchMedia('(prefers-color-scheme: light)').matches
							? 'light'
							: 'dark';
				document.documentElement.dataset.theme = theme;
			})();
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="MLE is a C++23 game engine with Vulkan rendering, Lua-driven UI, OpenAL audio, SDL window and input, and development tools."
		/>
		<link rel="icon" type="image/png" sizes="512x512" href={favicon} />
		<link rel="canonical" href={canonical} />
		<title>MLE · C++23 game engine documentation</title>
	</head>
	<body data-pagefind-ignore>
		<LandingHeader model={landing} />
		<main data-mle-landing data-mle-landing-version={landing.version.id}>
			<LandingHero model={landing} />
			<LandingFeatures model={landing} />
			<LandingDirectory sections={landing.sections} />
			<LandingEvidence model={landing} />
		</main>
		<footer>
			<span>MLE documentation</span>
			<span>Snapshot {landing.version.id}</span>
		</footer>
	</body>
</html>

<style>
	:global(html) {
		min-width: 20rem;
	}
	:global(body) {
		margin: 0;
		min-height: 100vh;
		background:
			radial-gradient(circle at 78% 8%, color-mix(in srgb, var(--mle-accent) 13%, transparent), transparent 29rem),
			var(--mle-bg);
	}
	main,
	footer {
		width: min(76rem, calc(100% - 3rem));
		margin-inline: auto;
	}
	footer {
		display: flex;
		justify-content: space-between;
		gap: var(--mle-space-4);
		padding-block: var(--mle-space-5);
		border-top: 1px solid var(--mle-border);
		font-family: var(--mle-font-code);
		font-size: 0.8rem;
		color: var(--mle-text-muted);
	}
	@media (max-width: 52rem) {
		main,
		footer { width: min(100% - 2rem, 40rem); }
		footer { flex-direction: column; }
	}
</style>
